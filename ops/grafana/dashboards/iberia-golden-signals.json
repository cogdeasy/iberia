{
  "uid": "iberia-golden-signals",
  "title": "Iberia — Golden Signals",
  "description": "Traffic, errors, latency and saturation for the Iberia API, built on the iberia_http_* metric families.",
  "tags": ["iberia", "sre", "golden-signals"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
        "query": "label_values(iberia_http_requests_total, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Traffic (req/s)",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iberia_http_requests_total{route=~\"$route\"}[5m]))",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx %)",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iberia_http_requests_total{route=~\"$route\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(iberia_http_requests_total{route=~\"$route\"}[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iberia_http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "In-flight requests (saturation)",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sum(iberia_http_in_flight_requests)", "legendFormat": "in flight" }
      ]
    },
    {
      "type": "row",
      "title": "Traffic & errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by status class",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(iberia_http_requests_total{route=~\"$route\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error ratio",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iberia_http_requests_total{route=~\"$route\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(iberia_http_requests_total{route=~\"$route\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        },
        {
          "refId": "B",
          "expr": "sum(rate(iberia_http_requests_total{route=~\"$route\",status=~\"4..\"}[5m])) / clamp_min(sum(rate(iberia_http_requests_total{route=~\"$route\"}[5m])), 0.001)",
          "legendFormat": "4xx ratio"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(iberia_http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iberia_http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iberia_http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum(iberia_http_in_flight_requests)", "legendFormat": "in flight" }
      ]
    },
    {
      "type": "row",
      "title": "Per-route breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "table",
      "title": "Top routes — rate, errors, p95",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "topk(15, sum by (route) (rate(iberia_http_requests_total[5m])))",
          "legendFormat": "rate"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (route) (rate(iberia_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "errors"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(iberia_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "route" } },
        { "id": "organize", "options": { "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true } } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by route",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(iberia_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Business events",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "timeseries",
      "title": "Domain events per second",
      "datasource": { "type": "prometheus", "uid": "iberia-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (domain, event) (rate(iberia_domain_events_total[5m]))",
          "legendFormat": "{{domain}} / {{event}}"
        }
      ]
    }
  ]
}
