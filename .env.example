# Iberia demo platform — environment settings
#
# Copy to backend/.env (or export in your shell) and adjust. Every value below maps to an
# attribute of `Settings` in backend/app/core/config.py. All defaults are demo-safe; nothing
# here is a real credential.
#
#   cp .env.example backend/.env
#   set -a && source backend/.env && set +a && make backend

# ---------------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------------

# Environment label stamped on every JSON log line and returned by /healthz.
# local | test | demo
IBERIA_ENV=local

# SQLAlchemy URL. The demo runs on SQLite so everything works offline.
IBERIA_DATABASE_URL=sqlite:///./iberia.db

# HS256 signing key for the API's JWTs. Obviously fake demo value — rotate for anything real.
IBERIA_JWT_SECRET=iberia-local-dev-secret

# Access-token lifetime in minutes. 720 = 12 hours, which is deliberately long for the demo
# (long-lived, non-revocable tokens are themselves a documented finding in the identity range).
IBERIA_JWT_TTL_MINUTES=720

# Root log level for the JSON logger. DEBUG | INFO | WARNING | ERROR
IBERIA_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API with credentials.
# Safe default for local development:
IBERIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# NOTE(demo): planted VULN-150 — the "kiosk / partner demo" configuration below sets a wildcard
# origin while credentials stay enabled, so the API reflects ANY origin back with
# Access-Control-Allow-Credentials: true. Any website a signed-in passenger visits can then read
# their booking data. Documented in docs/vulnerabilities/VULN-150-permissive-cors.md — do not
# "fix" it, it is part of the security demo.
# IBERIA_CORS_ORIGINS=*

# ---------------------------------------------------------------------------------------------
# Local ports / tooling (used by scripts/ and the Makefile, not by app/core/config.py)
# ---------------------------------------------------------------------------------------------

# Port scripts/dev.sh binds uvicorn to (Prometheus scrapes host.docker.internal:8000).
IBERIA_BACKEND_PORT=8000

# Base URL used by scripts/smoke.sh.
IBERIA_BASE_URL=http://127.0.0.1:8000
